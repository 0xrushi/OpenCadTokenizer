{
  "seed": 42,
  "device": "cuda",
  "data": {
    "root": "data/extracted",
    "database": "data/prepared/cad.sqlite",
    "validation_fraction": 0.02,
    "tokenizer_fraction": 0.5,
    "max_pair_tokens": 512,
    "max_primitives": 12,
    "extrusion_partition": "three"
  },
  "vq": {
    "output": "artifacts/vq",
    "width": 512,
    "heads": 8,
    "encoder_layers": 5,
    "decoder_layers": 5,
    "feedforward": 2048,
    "dropout": 0.1,
    "codebook_size": 2048,
    "commitment_weight": 0.25,
    "reconstruction_loss": "emd",
    "learning_rate": 0.0003,
    "weight_decay": 0.01,
    "batch_size": 64,
    "epochs": 250,
    "patience": 25,
    "gradient_clip": 1.0,
    "num_workers": 2
  },
  "alignment": {
    "output": "artifacts/alignment",
    "model_name": "meta-llama/Meta-Llama-3-8B",
    "revision": "main",
    "learning_rate": 0.0003,
    "batch_size": 64,
    "epochs": 250,
    "patience": 25,
    "validation_fraction": 0.1,
    "collision_policy": "unique_topk",
    "candidate_count": 256,
    "refinement_epochs": 25
  },
  "sft": {
    "output": "artifacts/sft",
    "encoded_database": "data/prepared/encoded.sqlite",
    "context_length": 1024,
    "editing_per_generation": 5,
    "batch_size": 1,
    "gradient_accumulation_steps": 16,
    "epochs": 20,
    "learning_rate": 0.0001,
    "weight_decay": 0.01,
    "warmup_ratio": 0.03,
    "lora_rank": 32,
    "lora_alpha": 32,
    "lora_dropout": 0.0,
    "lora_targets": ["q_proj", "k_proj", "v_proj", "o_proj", "gate_proj", "up_proj", "down_proj"],
    "gradient_checkpointing": true,
    "max_steps": -1,
    "logging_steps": 10,
    "report_to": ["tensorboard"],
    "early_stopping_patience": 5,
    "early_stopping_threshold": 0.0,
    "divergence_ratio": 2.0,
    "save_total_limit": 4
  }
}
